# Discord Settings
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here
DISCORD_TRACK_CHANNEL_ID=your_notification_channel_id_here

# Modrinth Settings
MODRINTH_USER_AGENT=YourName/ModrinthDiscordBot/1.0.0 (admin@yourdomain.com)

# Pterodactyl Integration
PTERODACTYL_URL=https://panel.yourdomain.com
PTERODACTYL_API_KEY=ptlc_xxxxxxxxx
PTERODACTYL_SERVER_ID=server_identifier_hex

# Tracker Interval (dalam menit, default 120 = 2 jam)
TRACKER_INTERVAL_MINUTES=120